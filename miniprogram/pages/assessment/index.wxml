<view class="page">
  <view class="card">
    <view class="title">小平菇评估</view>
    <view class="sub">用于初步了解心理困扰与咨询偏好。评估结果不构成医学诊断。</view>
  </view>

  <view class="card">
    <label class="label">姓名</label>
    <input class="input" value="{{form.visitor_name}}" data-key="visitor_name" bindinput="onInput" placeholder="可填写昵称" />

    <label class="label">年龄</label>
    <input class="input" type="number" value="{{form.visitor_age}}" data-key="visitor_age" bindinput="onInput" placeholder="请输入年龄" />

    <label class="label">填写身份</label>
    <picker mode="selector" range="{{filledByLabels}}" value="{{filledByIndex}}" data-key="filledByIndex" bindchange="onPickerChange">
      <view class="picker">{{filledByLabels[filledByIndex]}}</view>
    </picker>

    <label class="label">性别</label>
    <picker mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" data-key="genderIndex" bindchange="onPickerChange">
      <view class="picker">{{genderLabels[genderIndex]}}</view>
    </picker>

    <label class="label">职业身份</label>
    <picker mode="selector" range="{{occupationLabels}}" value="{{occupationIndex}}" data-key="occupationIndex" bindchange="onPickerChange">
      <view class="picker">{{occupationLabels[occupationIndex]}}</view>
    </picker>
    <input wx:if="{{showOccupationOther}}" class="input" value="{{form.occupation_other}}" data-key="occupation_other" bindinput="onInput" placeholder="请填写您的职业" />

    <label class="label">所在城市</label>
    <input class="input" value="{{form.visitor_city}}" data-key="visitor_city" bindinput="onInput" placeholder="如：上海" />

    <label class="label">是否接受过心理健康服务？</label>
    <picker mode="selector" range="{{prevCounselingLabels}}" value="{{prevCounselingIndex}}" data-key="prevCounselingIndex" bindchange="onPickerChange">
      <view class="picker">{{prevCounselingLabels[prevCounselingIndex]}}</view>
    </picker>

    <label class="label">希望的咨询方式</label>
    <view class="tag-row">
      <view wx:for="{{formatOptions}}" wx:key="value" class="tag {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="toggleFormat">{{item.label}}</view>
    </view>

    <label class="label">经济承受能力</label>
    <picker mode="selector" range="{{budgetLabels}}" value="{{budgetIndex}}" data-key="budgetIndex" bindchange="onPickerChange">
      <view class="picker">{{budgetLabels[budgetIndex]}}</view>
    </picker>

    <label class="label">对咨询师的性别偏好</label>
    <picker mode="selector" range="{{genderPrefLabels}}" value="{{genderPrefIndex}}" data-key="genderPrefIndex" bindchange="onPickerChange">
      <view class="picker">{{genderPrefLabels[genderPrefIndex]}}</view>
    </picker>

    <label class="label">对咨询师的年龄偏好</label>
    <picker mode="selector" range="{{agePrefLabels}}" value="{{agePrefIndex}}" data-key="agePrefIndex" bindchange="onPickerChange">
      <view class="picker">{{agePrefLabels[agePrefIndex]}}</view>
    </picker>

    <label class="label">性取向友善需求</label>
    <picker mode="selector" range="{{orientationPrefLabels}}" value="{{orientationPrefIndex}}" data-key="orientationPrefIndex" bindchange="onPickerChange">
      <view class="picker">{{orientationPrefLabels[orientationPrefIndex]}}</view>
    </picker>

    <label class="label">希望咨询师的沟通风格</label>
    <picker mode="selector" range="{{commStyleLabels}}" value="{{commStyleIndex}}" data-key="commStyleIndex" bindchange="onPickerChange">
      <view class="picker">{{commStyleLabels[commStyleIndex]}}</view>
    </picker>
  </view>

  <view class="card">
    <view class="group-title">咨询风格偏好</view>

    <label class="label">更有方向感，还是更自由探索？</label>
    <view class="tag-row">
      <view wx:for="{{cnipOptions.structure}}" wx:key="value" class="tag {{cnip.structure === item.value ? 'active' : ''}}" data-key="structure" data-value="{{item.value}}" bindtap="selectCnip">{{item.label}}</view>
    </view>

    <label class="label">深入感受情绪，还是聚焦解决问题？</label>
    <view class="tag-row">
      <view wx:for="{{cnipOptions.emotion}}" wx:key="value" class="tag {{cnip.emotion === item.value ? 'active' : ''}}" data-key="emotion" data-value="{{item.value}}" bindtap="selectCnip">{{item.label}}</view>
    </view>

    <label class="label">探讨过去，还是关注当下和未来？</label>
    <view class="tag-row">
      <view wx:for="{{cnipOptions.timefocus}}" wx:key="value" class="tag {{cnip.timefocus === item.value ? 'active' : ''}}" data-key="timefocus" data-value="{{item.value}}" bindtap="selectCnip">{{item.label}}</view>
    </view>

    <label class="label">温和支持，还是坦诚直接反馈？</label>
    <view class="tag-row">
      <view wx:for="{{cnipOptions.warmth}}" wx:key="value" class="tag {{cnip.warmth === item.value ? 'active' : ''}}" data-key="warmth" data-value="{{item.value}}" bindtap="selectCnip">{{item.label}}</view>
    </view>

    <label class="label">愿意在咨询之间做练习或记录吗？</label>
    <view class="tag-row">
      <view wx:for="{{cnipOptions.homework}}" wx:key="value" class="tag {{cnip.homework === item.value ? 'active' : ''}}" data-key="homework" data-value="{{item.value}}" bindtap="selectCnip">{{item.label}}</view>
    </view>

    <label class="label">想讨论你和咨询师之间的关系吗？</label>
    <view class="tag-row">
      <view wx:for="{{cnipOptions.relational}}" wx:key="value" class="tag {{cnip.relational === item.value ? 'active' : ''}}" data-key="relational" data-value="{{item.value}}" bindtap="selectCnip">{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <label class="label">您的咨询预期是</label>
    <view class="tag-row">
      <view wx:for="{{expectOptions}}" wx:key="value" class="tag {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="toggleExpect">{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <label class="label">主要困扰</label>
    <view class="tag-row">
      <view wx:for="{{issueOptions}}" wx:key="value" class="tag {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="toggleIssue">{{item.label}}</view>
    </view>

    <label class="label">简单描述</label>
    <textarea class="textarea" value="{{form.description}}" data-key="description" bindinput="onInput" placeholder="可以简单写写最近遇到的困难"></textarea>

    <label class="label">困扰持续时间</label>
    <picker mode="selector" range="{{durationLabels}}" value="{{durationIndex}}" data-key="durationIndex" bindchange="onPickerChange">
      <view class="picker">{{durationLabels[durationIndex]}}</view>
    </picker>
  </view>

  <view class="card">
    <view class="score-row" wx:for="{{scoreItems}}" wx:key="key">
      <view class="score-head">
        <text>{{item.label}}</text>
        <text>{{scores[item.key]}}/5</text>
      </view>
      <slider min="0" max="5" step="1" value="{{scores[item.key]}}" data-key="{{item.key}}" bindchange="onScoreChange" activeColor="#5C7A52" />
    </view>
  </view>

  <view class="card">
    <label class="label crisis-label">危机安全筛查（必填）</label>
    <picker mode="selector" range="{{crisisLabels}}" value="{{crisisIndex}}" bindchange="onCrisisChange">
      <view class="picker">{{crisisLabels[crisisIndex]}}</view>
    </picker>

    <view wx:if="{{crisisWarningVisible}}" class="crisis-alert">
      <view class="crisis-alert-title">请立即寻求紧急帮助</view>
      <view class="crisis-alert-text">当您有自伤或自杀的想法/行为时，请立即联系以下热线：</view>
      <view class="crisis-hotline">全国心理援助热线：12356</view>
      <view class="crisis-alert-text">服务对象：所有有心理需要的人</view>
      <view class="crisis-alert-text">服务时间：24小时 | 主办：国家及各地卫健委</view>
      <view class="crisis-hotline">妇女维权公益热线：12338</view>
      <view class="crisis-alert-text">服务对象：女性及儿童维权</view>
      <view class="crisis-alert-text">服务时间：24小时（心理咨询 8:00-23:00）| 主办：全国妇联</view>
      <view class="crisis-hotline">青少年法律与心理咨询热线：12355</view>
      <view class="crisis-alert-text">服务对象：青少年</view>
      <view class="crisis-alert-text">服务时间：9:00-19:00 | 主办：共青团</view>
      <view class="crisis-hotline">紧急情况请拨打 120 或 110</view>
      <view class="crisis-alert-note">本系统的转介建议不能替代紧急心理危机干预。</view>
    </view>

    <label class="label">是否有以下特殊情况？</label>
    <view class="tag-row">
      <view wx:for="{{specialOptions}}" wx:key="value" class="tag {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="toggleSpecial">{{item.label}}</view>
    </view>

    <button class="btn btn-primary" loading="{{submitting}}" bindtap="submitAssessment">生成评估并匹配</button>
  </view>

  <view wx:if="{{matchResultVisible}}" class="card match-result-card">
    <view class="group-title">转介匹配建议</view>
    <view wx:for="{{referralAdviceCards}}" wx:key="title" class="referral-card referral-{{item.tone}} {{item.top ? 'top' : ''}}">
      <view class="referral-badge">{{item.badge}}</view>
      <view class="referral-title">{{item.title}}</view>
      <view class="referral-desc">{{item.desc}}</view>
      <view class="referral-tags">
        <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="mini-tag">{{tag}}</view>
      </view>
      <view class="referral-tags require-tags">
        <view wx:for="{{item.require}}" wx:for-item="req" wx:key="*this" class="mini-tag warn">{{req}}</view>
      </view>
    </view>

    <view class="group-title">推荐咨询师</view>
    <view class="sub">请选择一位本地演示咨询师提交匹配申请。选择后，对应 web 咨询师工作台会收到这条待处理请求。</view>

    <view wx:if="{{recommendedCounselors.length === 0}}" class="empty-match">暂无可推荐咨询师，请稍后再试。</view>

    <view wx:for="{{recommendedCounselors}}" wx:key="id" class="counselor-card">
      <view class="counselor-head">
        <view>
          <view class="counselor-name">{{item.name || '未命名咨询师'}}</view>
          <view class="counselor-meta">{{item.meta_text}}</view>
        </view>
        <view class="match-score">匹配度 {{item.matchScore}}%</view>
      </view>
      <view wx:if="{{item.bio_short}}" class="counselor-bio">{{item.bio_short}}</view>
      <view class="counselor-tags">
        <view wx:for="{{item.approaches}}" wx:for-item="tag" wx:key="*this" class="mini-tag">{{tag}}</view>
      </view>
      <view class="counselor-info">{{item.fee_text}} · {{item.first_format}}</view>
      <view class="match-detail">{{item.match_details_text}}</view>
      <button class="btn btn-primary counselor-select-btn" loading="{{selectingCounselor}}" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="selectCounselor">选择这位咨询师</button>
    </view>
  </view>
</view>
