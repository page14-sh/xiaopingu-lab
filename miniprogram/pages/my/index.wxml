<view class="page">
  <view class="card">
    <view class="title">我的评估</view>
    <view class="sub">这里按微信身份展示你的评估记录、匹配申请状态和追踪入口。</view>
    <view wx:if="{{last_refreshed_text}}" class="refresh-text">已同步 {{last_refreshed_text}}</view>
  </view>

  <view wx:if="{{loading}}" class="card muted">加载中...</view>
  <view wx:elif="{{assessments.length === 0}}" class="card muted">暂无评估记录，先去完成一次评估吧。</view>

  <view wx:for="{{assessments}}" wx:key="id" class="card">
    <view class="title">{{item.visitor_name || '微信来访者'}}</view>
    <view class="sub">评估号 {{item.assessment_no}} · 总分 {{item.total_score || 0}}/25 · {{item.severity || '-'}} · {{item.created_at_text}}</view>
    <view class="tag-row">
      <view class="tag active">{{item.status_text}}</view>
      <view wx:if="{{item.selected_counselor_name}}" class="tag active">已选 {{item.selected_counselor_name}}</view>
    </view>
    <view class="advice-box">
      <view class="recommend-title">转介匹配建议</view>
      <view wx:for="{{item.referral_advice_cards}}" wx:for-item="advice" wx:key="title" class="advice-card advice-{{advice.tone}}">
        <view class="advice-badge">{{advice.badge}}</view>
        <view class="advice-title">{{advice.title}}</view>
        <view class="advice-sub">{{advice.desc}}</view>
      </view>
    </view>
    <view wx:if="{{item.can_apply_demo}}" class="recommend-box">
      <view class="recommend-title">选择推荐咨询师</view>
      <view wx:for="{{item.recommended_counselors}}" wx:for-item="counselor" wx:key="id" class="recommend-card">
        <view class="recommend-head">
          <view>
            <view class="recommend-name">{{counselor.name}}</view>
            <view class="recommend-meta">{{counselor.meta_text}}</view>
          </view>
          <view class="recommend-score">{{counselor.matchScore}}%</view>
        </view>
        <view class="recommend-sub">{{counselor.fee_text}} · {{counselor.first_format}}</view>
        <view class="recommend-sub">{{counselor.match_details_text}}</view>
        <button class="btn btn-primary" data-id="{{item.id}}" data-cid="{{counselor.id}}" data-name="{{counselor.name}}" bindtap="applyDemoCounselor">选择 {{counselor.name}}</button>
      </view>
    </view>
    <button class="btn btn-ghost" data-id="{{item.id}}" bindtap="openPcoms">填写 PCOMS</button>
  </view>
</view>
