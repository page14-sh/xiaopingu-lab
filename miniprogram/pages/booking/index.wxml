<view class="page">
  <view class="card">
    <view class="title">预约 {{counselorName}}</view>
    <view class="sub">仅展示未来一周。绿色可选，红色表示已被预约；提交后等待咨询师确认。</view>
  </view>
  <view wx:if="{{loading}}" class="card muted">正在加载日程…</view>
  <view wx:elif="{{slots.length === 0}}" class="card muted">咨询师暂未维护本周可预约时段。</view>
  <view wx:else class="card">
    <view wx:for="{{slots}}" wx:key="start_at" class="slot slot-{{item.state}}" data-state="{{item.state}}" data-start="{{item.start_at}}" data-text="{{item.text}}" bindtap="choose">
      <view>{{item.text}}</view><view class="slot-state">{{item.state === 'available' ? '可预约' : '已预约'}}</view>
    </view>
  </view>
</view>
