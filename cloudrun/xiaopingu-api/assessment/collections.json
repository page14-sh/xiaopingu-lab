{
  "schema_version": 1,
  "status": "declaration-only-not-provisioned",
  "client_access": { "read": false, "write": false },
  "collections": [
    {"name": "xg_matches", "document_id": "match_id"},
    {"name": "xg_active_matches", "document_id": "sha256(JSON([visitor_id,counselor_id]))"},
    {"name": "xg_assessment_events", "document_id": "event_id", "indexes": [{"name": "match_session_id", "unique": false, "fields": [{"name": "match_id", "direction": "asc"}, {"name": "session_no", "direction": "asc"}, {"name": "_id", "direction": "asc"}]}, {"name": "stats_id_time", "unique": false, "fields": [{"name": "_id", "direction": "asc"}, {"name": "started_at", "direction": "asc"}]}, {"name": "status_expiry_id", "unique": false, "fields": [{"name": "status", "direction": "asc"}, {"name": "expires_at", "direction": "asc"}, {"name": "_id", "direction": "asc"}]}]},
    {"name": "xg_submissions", "document_id": "sha256(JSON([match_id,scale_code,position,follow_round]))"},
    {"name": "xg_baseline_profiles", "document_id": "match_id"},
    {"name": "xg_end_profiles", "document_id": "match_id"},
    {"name": "xg_visitors", "document_id": "wx_ + sha256(JSON([appid,openid]))"},
    {"name": "xg_identity_assertions", "document_id": "assertion jti", "cleanup": "Only delete after expires_at; never before assertion expiry"},
    {"name": "xg_intake_owners", "document_id": "assessment_id"},
    {"name": "xg_match_requests", "document_id": "request_id"},
    {"name": "xg_case_switches", "document_id": "match_id"},
    {"name": "xg_llm_results", "document_id": "event_id", "required_scope": ["match_id", "visitor_id", "counselor_id"], "indexes": [{"name": "match_result_id", "unique": false, "fields": [{"name": "match_id", "direction": "asc"}, {"name": "_id", "direction": "asc"}]}]},
    {"name": "xg_consent_policies", "document_id": "scope"},
    {"name": "xg_consent_documents", "document_id": "sha256(JSON([scope,version]))", "immutable": true},
    {"name": "xg_consent_states", "document_id": "sha256(JSON([visitor_id,scope]))"},
    {"name": "xg_consent_history", "document_id": "sha256(JSON([visitor_id,client_event_id]))", "append_only": true, "indexes": [{"name": "visitor_scope_revision", "unique": false, "fields": [{"name": "visitor_id", "direction": "asc"}, {"name": "scope", "direction": "asc"}, {"name": "revision", "direction": "asc"}]}]},
    {"name": "xg_item_versions", "document_id": "item_version", "immutable": true},
    {"name": "xg_rule_versions", "document_id": "rule_version", "immutable": true},
    {"name": "xg_assessment_release", "document_id": "current"},
    {"name": "xg_case_assessment_configs", "document_id": "sha256(JSON([match_id,revision]))", "append_only": true},
    {"name": "xg_event_transitions", "document_id": "sha256(JSON([event_id,event_revision]))", "append_only": true},
    {"name": "xg_request_receipts", "document_id": "sha256(JSON([request,actor_role,actor_id,operation,request_id]))", "append_only": true},
    {"name": "xg_combination_jobs", "document_id": "match_id"},
    {"name": "xg_raw_signals", "document_id": "sha256(JSON([match_id,session_no]))"},
    {"name": "xg_session_combinations", "document_id": "sha256(JSON([match_id,session_no]))"},
    {"name": "xg_combination_history", "document_id": "sha256(JSON([match_id,session_no,revision]))", "append_only": true},
    {"name": "xg_rollout_policy", "document_id": "current"},
    {"name": "xg_rollout_history", "document_id": "sha256(JSON([scope,match_id,revision]))", "append_only": true},
    {"name": "xg_followup_jobs", "document_id": "sha256(JSON([followup,match_id,follow_round]))", "indexes": [{"name": "status_check_id", "unique": false, "fields": [{"name": "status", "direction": "asc"}, {"name": "next_check_at", "direction": "asc"}, {"name": "_id", "direction": "asc"}]}, {"name": "stats_id_time", "unique": false, "fields": [{"name": "_id", "direction": "asc"}, {"name": "due_at", "direction": "asc"}]}]},
    {"name": "xg_notification_tasks", "document_id": "stable business task id; followup uses followup job id", "indexes": [{"name": "status_attempt_id", "unique": false, "fields": [{"name": "status", "direction": "asc"}, {"name": "next_attempt_at", "direction": "asc"}, {"name": "_id", "direction": "asc"}]}, {"name": "stats_id_time", "unique": false, "fields": [{"name": "_id", "direction": "asc"}, {"name": "created_at", "direction": "asc"}]}]},
    {"name": "xg_notification_attempts", "document_id": "sha256(JSON([task_id,attempt_number]))", "indexes": [{"name": "scoped_order", "unique": false, "fields": [{"name": "task_id", "direction": "asc"}, {"name": "number", "direction": "asc"}]}, {"name": "stats_id_time", "unique": false, "fields": [{"name": "_id", "direction": "asc"}, {"name": "started_at", "direction": "asc"}]}]},
    {"name": "xg_notification_inbox", "document_id": "task_id", "indexes": [{"name": "scoped_order", "unique": false, "fields": [{"name": "recipient_role", "direction": "asc"}, {"name": "recipient_id", "direction": "asc"}, {"name": "created_at", "direction": "desc"}, {"name": "_id", "direction": "asc"}]}, {"name": "stats_id_time", "unique": false, "fields": [{"name": "_id", "direction": "asc"}, {"name": "created_at", "direction": "asc"}]}]},
    {"name": "xg_notification_recipients", "document_id": "sha256(JSON([recipient_role,recipient_id]))"},
    {"name": "xg_notification_audit", "document_id": "sha256(JSON([kind,entity_id,revision]))", "append_only": true},
    {"name": "xg_notification_bridge", "document_id": "notification attempt_id"},
    {"name": "xg_alert_actions", "document_id": "signal_id", "indexes": [{"name": "stats_id_time", "unique": false, "fields": [{"name": "_id", "direction": "asc"}, {"name": "created_at", "direction": "asc"}]}]},
    {"name": "xg_llm_jobs", "document_id": "event_id", "indexes": [{"name": "status_attempt_id", "unique": false, "fields": [{"name": "status", "direction": "asc"}, {"name": "next_attempt_at", "direction": "asc"}, {"name": "_id", "direction": "asc"}]}, {"name": "status_recovery_id", "unique": false, "fields": [{"name": "status", "direction": "asc"}, {"name": "recovery_eligible", "direction": "asc"}, {"name": "recover_at", "direction": "asc"}, {"name": "_id", "direction": "asc"}]}, {"name": "status_id", "unique": false, "fields": [{"name": "status", "direction": "asc"}, {"name": "_id", "direction": "asc"}]}, {"name": "stats_id_time", "unique": false, "fields": [{"name": "_id", "direction": "asc"}, {"name": "created_at", "direction": "asc"}]}]},
    {"name": "xg_llm_attempts", "document_id": "sha256(JSON([event_id,generation,attempt_number]))"},
    {"name": "xg_llm_history", "document_id": "sha256(JSON([event_id,generation]))", "immutable": true},
    {"name": "xg_llm_audit", "document_id": "deterministic operation/revision or reprocess request key", "append_only": true},
    {"name": "xg_tag_weight_proposals", "document_id": "sha256(JSON([event_id,generation]))"},
    {"name": "xg_tag_weights", "document_id": "match_id", "scope": "advisory LLM multipliers only; never deterministic scores"},
    {"name": "xg_risk_states", "document_id": "match_id", "scope": "cycle risk trigger, cooldown and out-of-scope state"}
  ]
}
