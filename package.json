{
  "scripts": {
    "start:server": "HOST=0.0.0.0 node server/local-api-server.js",
    "start:web": "python3 -m http.server 8080 --bind 127.0.0.1 --directory web",
    "docker:server": "docker compose -f server/docker-compose.yml up --build",
    "prepare:cloudrun": "node scripts/prepare-cloudrun-web.js",
    "test:cloudbase": "npm test --prefix cloudrun/xiaopingu-api",
    "test:legacy-security": "node --test scripts/legacy-security.test.cjs scripts/legacy-gateway.test.cjs scripts/followup-adapter.test.cjs scripts/web-auth-boundary.test.cjs",
    "sync:cloudbase:data": "node scripts/sync-cloudbase-data.js",
    "demo:assessment": "node scripts/verify-assessment-demo.cjs",
    "check:assessment:release": "node scripts/check-assessment-release.cjs"
  }
}
